{%- comment -%}
  Sección de la página Power Factor X1. El diseño está en layout/power-factor.liquid;
  aquí solo se muestran los bloques de apps (Releasit, reseñas, etc.) agregados desde el editor.
{%- endcomment -%}
{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when '@app' -%}
      {% render block %}
  {%- endcase -%}
{%- endfor -%}
{% schema %}
{
  "name": "Power Factor X1",
  "blocks": [{ "type": "@app" }],
  "settings": []
}
{% endschema %}
